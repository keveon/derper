{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "mode": "full",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "ignoreTests": true,
  "packageRules": [
    {
      "description": "Automerge patch updates.",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge patch and minor Docker base image updates.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge patch and minor GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Major updates stay for manual review.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
